import beneficios.*
import coordinadores.*
import packs.*
describe "test de agencia de viajes" {
  
//beneficio
    test "Un beneficio guarda sus datos" {
        const traslado = new Beneficio(
            tipo = "Traslados privados",
            costo = 10000,
            vigente = true
        )

        assert.equals("Traslados privados", traslado.tipo())
        assert.equals(10000, traslado.costo())
        assert.equals(true, traslado.vigente())
    }

    //rol
    test "Un coordinador puede cambiar de rol" {
        const coordinador = new Coordinador(
            viajesRealizados = 10,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        coordinador.cambiarRol("Acompañante")

        assert.equals("Acompañante", coordinador.rol())
    }

    //prueba roles coordinador
    test "Un guia motivado con mas de 20 viajes esta calificado" {
        const guia = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 1,
            rol = "Guía"
        )

        assert.equals(true, guia.estaAltamenteCalificado())
    }

    test "Un asistente con poca experiencia no esta calificado" {
        const asistente = new Coordinador(
            viajesRealizados = 30,
            motivado = true,
            aniosExperiencia = 2,
            rol = "Asistente logístico"
        )

        assert.equals(false, asistente.estaAltamenteCalificado())
    }

    test "Un acompañante con mas de 20 viajes esta calificado" {
        const acompañante = new Coordinador(
            viajesRealizados = 21,
            motivado = false,
            aniosExperiencia = 0,
            rol = "Acompañante"
        )

        assert.equals(true, acompañante.estaAltamenteCalificado())
    }

    test "Un coordinador con exactamente 20 viajes no esta calificado" {
        const guia = new Coordinador(
            viajesRealizados = 20,
            motivado = true,
            aniosExperiencia = 5,
            rol = "Guía"
        )

        assert.equals(false, guia.estaAltamenteCalificado())
    }

    test "Un rol inválido no cambia el rol del coordinador" {
        const coordinador = new Coordinador(
            viajesRealizados = 10,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        assert.equals("Guía", coordinador.rol())
    }
    
    //crea y consulta datos de pack nacional
    test "Un pack nacional puede crearse" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const pack = new PackNacional(
            duracion = 12,
            precioBase = 100000,
            beneficios = [],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Montañismo", "Visita a bodegas"]
        )

        assert.equals(12, pack.duracion())
        assert.equals("Mendoza", pack.provinciaDestino())
    }

    test "Un pack nacional sin beneficios cuesta su precio base" {
        const coordinador = new Coordinador(
            viajesRealizados = 10,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const pack = new PackNacional(
            duracion = 7,
            precioBase = 100000,
            beneficios = [],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Trekking"]
        )

        assert.equals(100000, pack.precioFinal())
    }
    
    // precio final con beneficios vigentes
    test "Un pack nacional suma solo los beneficios vigentes" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const traslado = new Beneficio(
            tipo = "Traslados privados",
            costo = 10000,
            vigente = true
        )

        const seguro = new Beneficio(
            tipo = "Seguros adicionales",
            costo = 5000,
            vigente = true
        )

        const salaVIP = new Beneficio(
            tipo = "Acceso a salas VIP",
            costo = 3000,
            vigente = false
        )

        const pack = new PackNacional(
            duracion = 12,
            precioBase = 100000,
            beneficios = [traslado, seguro, salaVIP],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Montañismo", "Visita a bodegas"]
        )

        assert.equals(115000, pack.precioFinal())
    }

    //precio de pack internacional
    
    test "Un pack internacional aplica el recargo del 20 por ciento" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const pack = new PackInternacional(
            duracion = 25,
            precioBase = 100000,
            beneficios = [],
            coordinador = coordinador,
            paisDestino = "Italia",
            cantidadEscalas = 0,
            lugarDeInteres = true
        )

        assert.equals(120000, pack.precioFinal())
    }

    test "Un pack internacional sin beneficios cobra el 20 por ciento extra" {
        const coordinador = new Coordinador(
            viajesRealizados = 10,
            motivado = false,
            aniosExperiencia = 1,
            rol = "Acompañante"
        )

        const pack = new PackInternacional(
            duracion = 15,
            precioBase = 100000,
            beneficios = [],
            coordinador = coordinador,
            paisDestino = "Brasil",
            cantidadEscalas = 1,
            lugarDeInteres = false
        )

        assert.equals(120000, pack.precioFinal())
    }
    test "Un pack provincial puede ser premium" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const beneficio1 = new Beneficio(
            tipo = "Traslado",
            costo = 1000,
            vigente = true
        )

        const beneficio2 = new Beneficio(
            tipo = "Seguro",
            costo = 2000,
            vigente = true
        )

        const beneficio3 = new Beneficio(
            tipo = "Excursión",
            costo = 3000,
            vigente = true
        )

        const pack = new PackProvincial(
            duracion = 12,
            precioBase = 100000,
            beneficios = [beneficio1, beneficio2, beneficio3],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Montañismo", "Bodegas", "Trekking", "Cabalgata"],
            ciudadesAVisitar = 6
        )

        assert.equals(true, pack.esPremium())
    }

    test "Un pack provincial premium tiene un recargo del 5 por ciento" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const beneficio1 = new Beneficio(
            tipo = "Traslado",
            costo = 1000,
            vigente = true
        )

        const beneficio2 = new Beneficio(
            tipo = "Seguro",
            costo = 2000,
            vigente = true
        )

        const beneficio3 = new Beneficio(
            tipo = "Excursión",
            costo = 3000,
            vigente = true
        )

        const pack = new PackProvincial(
            duracion = 12,
            precioBase = 100000,
            beneficios = [beneficio1, beneficio2, beneficio3],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Montañismo", "Bodegas", "Trekking", "Cabalgata"],
            ciudadesAVisitar = 6
        )

        assert.equals(111300, pack.precioFinal())
    }

    test "Un pack provincial no premium no tiene recargo" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const beneficio1 = new Beneficio(
            tipo = "Traslado",
            costo = 1000,
            vigente = true
        )

        const pack = new PackProvincial(
            duracion = 12,
            precioBase = 100000,
            beneficios = [beneficio1],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Montañismo", "Bodegas", "Trekking", "Cabalgata"],
            ciudadesAVisitar = 6
        )

        assert.equals(false, pack.esPremium())
        assert.equals(101000, pack.precioFinal())
    }

    test "Un pack internacional suma el 20 por ciento" {
        const coordinador = new Coordinador(
            viajesRealizados = 10,
            motivado = false,
            aniosExperiencia = 1,
            rol = "Acompañante"
        )

        const beneficio = new Beneficio(
            tipo = "Seguro",
            costo = 5000,
            vigente = true
        )

        const pack = new PackInternacional(
            duracion = 15,
            precioBase = 100000,
            beneficios = [beneficio],
            coordinador = coordinador,
            paisDestino = "Brasil",
            cantidadEscalas = 1,
            lugarDeInteres = false
        )

        assert.equals(126000, pack.precioFinal())
    }

    //polimorfismo:todos los packs puedan responder a esPremium(), pero cada tipo de pack tenga sus propias reglas.
    test "Cada tipo de pack evalúa su propio criterio premium" {
        const coordinador = new Coordinador(
            viajesRealizados = 21,
            motivado = true,
            aniosExperiencia = 4,
            rol = "Guía"
        )

        const nacional = new PackNacional(
            duracion = 12,
            precioBase = 100000,
            beneficios = [],
            coordinador = coordinador,
            provinciaDestino = "Mendoza",
            actividades = ["Trekking"]
        )

        const internacional = new PackInternacional(
            duracion = 25,
            precioBase = 200000,
            beneficios = [],
            coordinador = coordinador,
            paisDestino = "Italia",
            cantidadEscalas = 0,
            lugarDeInteres = true
        )

        assert.equals(true, nacional.esPremium())
        assert.equals(true, internacional.esPremium())
    }
}
